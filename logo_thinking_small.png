l=dpl_BpqTEjuFdzJsZvrWdq4WeQnA6awt\",\"39118\",\"static/chunks/39118-38a96a3c6b6f1569.js?dpl=dpl_BpqTEjuFdzJsZvrWdq4WeQnA6awt\",\"23554\",\"static/chunks/23554-90d22a3291771a79.js?dpl=dpl_BpqTEjuFdzJsZvrWdq4WeQnA6awt\",\"44257\",\"static/chunks/44257-f048b143646778b9.js?dpl=dpl_BpqTEjuFdzJsZvrWdq4WeQnA6awt\",\"80490\",\"static/chunks/app/%5Blocale%5D/(static)/not-found-20df13127a4f1b8c.js?dpl=dpl_BpqTEjuFdzJsZvrWdq4WeQnA6awt\"],\"Trophy\"]\n24:[\"$\",\"p\",null,{\"className\":\"font-mono text-[96px] font-normal\",\"children\":\"404\"}]\n25:[\"$\",\"p\",null,{\"className\":\"text-text-secondary text-center text-lg font-normal\",\"children\":\"Sorry, we cannot find the page you are looking for.\"}]\n26:[\"$\",\"div\",null,{\"className\":\"mt-6 flex flex-row gap-2 md:gap-4\",\"children\":[[\"$\",\"$L27\",null,{\"variant\":\"outline\",\"size\":\"lg\",\"className\":\"gap-2\",\"asChild\":true,\"children\":[\"$\",\"$L28\",null,{\"href\":\"/\",\"children\":[[\"$\",\"$L29\",null,{\"size\":16}],\" Start New Chat\"]}]}],[\"$\",\"$L27\",null,{\"variant\":\"outline\",\"size\":\"lg\",\"className\":\"gap-2\",\"asChild\":true,\"children\":[\"$\",\"$L28\",null,{\"href\":\"/leaderboard\",\"children\":[[\"$\",\"$L2a\",null,{\"size\":16}],\" View Leaderboard\"]}]}]]}]\n"])</script><script>self.__next_f.push([1,"2b:T72f5,"])</script><script>self.__next_f.push([1,"1.\n\n```\n\"\"\"\nAI Studio — Streamlit\nTab 1: Image generation (Cloudflare Workers AI / FLUX)\nTab 2: Long-context chat (Groq / Moonshot Kimi K2)\n\nPublic-ready: credentials only from Streamlit Secrets.\nUI: bilingual ID + EN\n\"\"\"\n\nfrom __future__ import annotations\n\nimport base64\nimport html\nimport io\nimport time\nfrom datetime import datetime\n\nimport requests\nimport streamlit as st\nfrom openai import OpenAI\nfrom PIL import Image\n\nfrom styles import inject_glass_theme\n\n# ---------------------------------------------------------------------------\n# Page\n# ---------------------------------------------------------------------------\nst.set_page_config(\n    page_title=\"AI Studio\",\n    page_icon=\"✨\",\n    layout=\"centered\",\n    initial_sidebar_state=\"collapsed\",\n)\n\n# Apply glass modern theme ASAP (after page config)\ninject_glass_theme()\n\n# Cloudflare image\nCF_API_BASE = \"https://api.cloudflare.com/client/v4/accounts\"\nCF_IMAGE_MODEL = \"@cf/black-forest-labs/flux-1-schnell\"\nCF_DEFAULT_STEPS = 4\nIMAGE_MIN_LOADING_SECONDS = 10\n\n# Chat thinking sequence (~15s total): (label, hold_seconds)\n# Each line fades in (~1.1s CSS), then holds for the step duration.\nCHAT_THINK_STEPS: list[tuple[str, float]] = [\n    (\"Mencerna pertanyaan.....\", 3.0),\n    (\"Observaching.......\", 3.0),\n    (\"Ask yuki.ai.....\", 2.0),\n    (\"Ask aira.ai......\", 2.0),\n    (\"Memutar otak.....\", 3.0),\n    (\"Menyusun jawaban.....\", 2.0),\n]  # sum = 15s\nTHINK_FADE_SECONDS = 1.1\nTHINK_TOTAL_SECONDS = sum(d for _, d in CHAT_THINK_STEPS)\n\n# Groq chat — long context\n# NOTE (2026): moonshotai/kimi-k2-instruct and kimi-k2-instruct-0905 were\n# deprecated/shutdown on Groq. Production long-context default:\nGROQ_BASE_URL = \"https://api.groq.com/openai/v1\"\nGROQ_MODEL = \"openai/gpt-oss-120b\"  # ~131K context, production\n# Tried in order if the preferred model is gone / not found\nGROQ_MODEL_FALLBACKS = (\n    \"openai/gpt-oss-120b\",\n    \"qwen/qwen3.6-27b\",\n    \"openai/gpt-oss-20b\",\n)\n# Keep last N messages sent to API (user+assistant turns)\nMAX_HISTORY_MESSAGES = 40\nSYSTEM_PROMPT = (\n    \"You are a helpful assistant. Reply clearly and concisely unless the user \"\n    \"asks for detail. The user may write in Indonesian or English — mirror their language. \"\n    \"You handle long context well; stay coherent across the conversation.\"\n)\n\n\ndef t(id_text: str, en_text: str) -\u003e str:\n    return f\"{id_text} / {en_text}\"\n\n\ndef init_state() -\u003e None:\n    defaults = {\n        # image\n        \"img_bytes\": None,\n        \"img_prompt\": \"\",\n        \"img_error\": None,\n        # chat\n        \"chat_messages\": [],  # list[{role, content}]\n        \"chat_error\": None,\n    }\n    for k, v in defaults.items():\n        if k not in st.session_state:\n            st.session_state[k] = v\n\n\ninit_state()\n\n\n# ---------------------------------------------------------------------------\n# Secrets\n# ---------------------------------------------------------------------------\ndef _secret_flat(*keys: str) -\u003e str:\n    try:\n        for key in keys:\n            if key in st.secrets:\n                val = st.secrets.get(key)\n                if val is not None and str(val).strip():\n                    return str(val).strip()\n    except Exception:\n        pass\n    return \"\"\n\n\ndef _secret_nested(sections: tuple[str, ...], nested_keys: tuple[str, ...]) -\u003e str:\n    try:\n        for section in sections:\n            if section not in st.secrets:\n                continue\n            block = st.secrets[section]\n            for nk in nested_keys:\n                try:\n                    val = block[nk]\n                except Exception:\n                    continue\n                if val is not None and str(val).strip():\n                    return str(val).strip()\n    except Exception:\n        pass\n    return \"\"\n\n\ndef load_cf_credentials() -\u003e tuple[str, str]:\n    account = _secret_flat(\"CF_ACCOUNT_ID\", \"CLOUDFLARE_ACCOUNT_ID\", \"ACCOUNT_ID\")\n    if not account:\n        account = _secret_nested(\n            (\"cloudflare\", \"cf\", \"CLOUDFLARE\"),\n            (\"account_id\", \"ACCOUNT_ID\", \"CF_ACCOUNT_ID\", \"CLOUDFLARE_ACCOUNT_ID\"),\n        )\n    token = _secret_flat(\"CF_API_TOKEN\", \"CLOUDFLARE_API_TOKEN\")\n    if not token:\n        token = _secret_nested(\n            (\"cloudflare\", \"cf\", \"CLOUDFLARE\"),\n            (\"api_token\", \"API_TOKEN\", \"CF_API_TOKEN\", \"CLOUDFLARE_API_TOKEN\", \"token\"),\n        )\n    return account, token\n\n\ndef load_groq_key() -\u003e str:\n    key = _secret_flat(\"GROQ_API_KEY\", \"GROQ_KEY\")\n    if not key:\n        key = _secret_nested(\n            (\"groq\", \"GROQ\"),\n            (\"api_key\", \"API_KEY\", \"GROQ_API_KEY\", \"key\"),\n        )\n    return key\n\n\ndef load_groq_model() -\u003e str:\n    model = _secret_flat(\"GROQ_MODEL\")\n    if not model:\n        model = _secret_nested((\"groq\", \"GROQ\"), (\"model\", \"MODEL\", \"GROQ_MODEL\"))\n    return model or GROQ_MODEL\n\n\n# ---------------------------------------------------------------------------\n# Public-friendly errors\n# ---------------------------------------------------------------------------\ndef public_error_image(status: int | None, body: str, exc: Exception | None = None) -\u003e str:\n    text = (body or str(exc or \"\")).lower()\n    if status in (401, 403) or \"authentication\" in text or \"forbidden\" in text or \"permission\" in text:\n        return t(\n            \"⚠️ Layanan gambar sedang tidak tersedia. Coba lagi nanti.\",\n            \"⚠️ Image service is unavailable. Please try again later.\",\n        )\n    if status == 429 or \"rate\" in text or \"neuron\" in text or \"quota\" in text:\n        return t(\n            \"⏳ Kuota gambar harian sedang penuh. Coba lagi nanti.\",\n            \"⏳ Daily image quota is full. Please try again later.\",\n        )\n    if \"timeout\" in text:\n        return t(\n            \"⌛ Server terlalu lama merespons. Coba lagi.\",\n            \"⌛ Server timed out. Please try again.\",\n        )\n    return t(\n        \"❌ Gagal membuat gambar. Coba prompt lain atau ulangi sebentar lagi.\",\n        \"❌ Failed to generate image. Try another prompt or retry shortly.\",\n    )\n\n\ndef public_error_chat(exc: Exception) -\u003e str:\n    text = str(exc).lower()\n    status = getattr(exc, \"status_code\", None)\n    code = \"\"\n    try:\n        body = getattr(exc, \"body\", None) or {}\n        if isinstance(body, dict):\n            err = body.get(\"error\") or body\n            if isinstance(err, dict):\n                code = str(err.get(\"code\") or err.get(\"type\") or \"\").lower()\n    except Exception:\n        pass\n\n    if (\n        status == 401\n        or \"401\" in text\n        or \"invalid_api_key\" in text\n        or \"invalid api key\" in text\n        or \"authentication\" in text\n        or \"unauthorized\" in text\n    ):\n        return t(\n            \"⚠️ Layanan chat sedang tidak tersedia (konfigurasi). Coba lagi nanti.\",\n            \"⚠️ Chat service unavailable (configuration). Please try again later.\",\n        )\n\n    if (\n        status == 404\n        or \"model_not_found\" in text\n        or \"does not exist\" in text\n        or \"model_decommissioned\" in text\n        or \"decommissioned\" in text\n        or code == \"model_not_found\"\n    ):\n        return t(\n            \"⚠️ Model chat tidak tersedia lagi di provider. Pemilik app perlu update model.\",\n            \"⚠️ Chat model is no longer available. The app owner needs to update the model.\",\n        )\n\n    if status == 429 or \"429\" in text or \"rate_limit\" in text or \"rate limit\" in text or \"quota\" in text:\n        return t(\n            \"⏳ Kuota chat sedang penuh. Coba lagi nanti.\",\n            \"⏳ Chat quota is full right now. Please try again later.\",\n        )\n\n    if \"timeout\" in text:\n        return t(\n            \"⌛ Respons terlalu lama. Coba lagi.\",\n            \"⌛ Response timed out. Please try again.\",\n        )\n\n    return t(\n        \"❌ Gagal membalas. Coba kirim ulang atau clear chat.\",\n        \"❌ Failed to reply. Resend or clear the chat.\",\n    )\n\n\ndef _is_model_unavailable_error(exc: Exception) -\u003e bool:\n    text = str(exc).lower()\n    status = getattr(exc, \"status_code\", None)\n    return (\n        status == 404\n        or \"model_not_found\" in text\n        or \"does not exist\" in text\n        or \"model_decommissioned\" in text\n        or \"decommissioned\" in text\n        or \"not_found\" in text and \"model\" in text\n    )\n\n\n# ---------------------------------------------------------------------------\n# Image generation (Cloudflare)\n# ---------------------------------------------------------------------------\ndef extract_image_bytes(payload: dict) -\u003e bytes:\n    if not isinstance(payload, dict):\n        raise RuntimeError(\"invalid response\")\n    if payload.get(\"success\") is False:\n        raise RuntimeError(str(payload.get(\"errors\") or payload))\n\n    result = payload.get(\"result\", payload)\n    if isinstance(result, str):\n        b64 = result\n    elif isinstance(result, dict):\n        b64 = result.get(\"image\") or result.get(\"b64_json\") or result.get(\"base64\")\n        if b64 is None and isinstance(result.get(\"data\"), list) and result[\"data\"]:\n            first = result[\"data\"][0]\n            if isinstance(first, dict):\n                b64 = first.get(\"b64_json\") or first.get(\"image\")\n            elif isinstance(first, str):\n                b64 = first\n        if b64 is None:\n            nested = result.get(\"result\")\n            if isinstance(nested, dict):\n                b64 = nested.get(\"image\")\n            elif isinstance(nested, str):\n                b64 = nested\n    else:\n        b64 = None\n\n    if not b64 or not isinstance(b64, str):\n        raise RuntimeError(\"no image\")\n\n    if \",\" in b64 and b64.strip().lower().startswith(\"data:\"):\n        b64 = b64.split(\",\", 1)[1]\n\n    raw = base64.b64decode(b64, validate=False)\n    if not raw:\n        raise RuntimeError(\"empty image\")\n\n    try:\n        im = Image.open(io.BytesIO(raw))\n        if im.mode not in (\"RGB\", \"RGBA\"):\n            im = im.convert(\"RGBA\" if \"A\" in im.getbands() else \"RGB\")\n        buf = io.BytesIO()\n        im.save(buf, format=\"PNG\")\n        return buf.getvalue()\n    except Exception:\n        return raw\n\n\ndef generate_image(account_id: str, api_token: str, prompt: str) -\u003e bytes:\n    url = f\"{CF_API_BASE}/{account_id.strip()}/ai/run/{CF_IMAGE_MODEL}\"\n    headers = {\n        \"Authorization\": f\"Bearer {api_token.strip()}\",\n        \"Content-Type\": \"application/json\",\n    }\n    body = {\"prompt\": prompt, \"steps\": CF_DEFAULT_STEPS}\n\n    try:\n        resp = requests.post(url, headers=headers, json=body, timeout=180)\n    except requests.Timeout as e:\n        raise RuntimeError(\"timeout\") from e\n    except requests.RequestException as e:\n        raise RuntimeError(str(e)) from e\n\n    content_type = (resp.headers.get(\"Content-Type\") or \"\").lower()\n    if \"image/\" in content_type:\n        if resp.status_code \u003e= 400:\n            raise RuntimeError(public_error_image(resp.status_code, resp.text[:400]))\n        raw = resp.content\n        try:\n            im = Image.open(io.BytesIO(raw))\n            buf = io.BytesIO()\n            im.save(buf, format=\"PNG\")\n            return buf.getvalue()\n        except Exception:\n            return raw\n\n    try:\n        payload = resp.json()\n    except Exception:\n        if resp.status_code \u003e= 400:\n            raise RuntimeError(public_error_image(resp.status_code, resp.text[:400]))\n        raise RuntimeError(\"invalid response\")\n\n    if resp.status_code \u003e= 400:\n        err = payload.get(\"errors\") if isinstance(payload, dict) else payload\n        raise RuntimeError(public_error_image(resp.status_code, str(err)[:400]))\n\n    return extract_image_bytes(payload)\n\n\n# ---------------------------------------------------------------------------\n# Chat (Groq / Moonshot Kimi K2)\n# ---------------------------------------------------------------------------\ndef build_chat_client(api_key: str) -\u003e OpenAI:\n    return OpenAI(api_key=api_key, base_url=GROQ_BASE_URL)\n\n\ndef messages_for_api(history: list[dict]) -\u003e list[dict]:\n    \"\"\"System + trimmed history for long-context but free-tier friendly sends.\"\"\"\n    trimmed = history[-MAX_HISTORY_MESSAGES:]\n    return [{\"role\": \"system\", \"content\": SYSTEM_PROMPT}, *trimmed]\n\n\ndef resolve_model_chain(preferred: str) -\u003e list[str]:\n    \"\"\"Preferred model first, then unique fallbacks.\"\"\"\n    chain: list[str] = []\n    for m in (preferred, *GROQ_MODEL_FALLBACKS):\n        if m and m not in chain:\n            chain.append(m)\n    return chain\n\n\ndef stream_chat_reply(client: OpenAI, model: str, history: list[dict]):\n    \"\"\"Yield text chunks from Groq streaming chat completion.\"\"\"\n    stream = client.chat.completions.create(\n        model=model,\n        messages=messages_for_api(history),\n        temperature=0.7,\n        stream=True,\n    )\n    for chunk in stream:\n        try:\n            delta = chunk.choices[0].delta\n            piece = getattr(delta, \"content\", None)\n            if piece:\n                yield piece\n        except Exception:\n            continue\n\n\ndef stream_chat_with_fallback(client: OpenAI, preferred_model: str, history: list[dict]):\n    \"\"\"\n    Try preferred model, then fallbacks if model is deprecated/missing.\n    Yields text chunks from the first model that accepts the request.\n    \"\"\"\n    last_exc: Exception | None = None\n    for model in resolve_model_chain(preferred_model):\n        try:\n            # Prime the stream — failure often happens on first iteration / create()\n            stream_iter = stream_chat_reply(client, model, history)\n            first = next(stream_iter, None)\n            if first:\n                yield first\n            for piece in stream_iter:\n                yield piece\n            return\n        except Exception as e:\n            last_exc = e\n            if _is_model_unavailable_error(e):\n                continue  # try next model\n            raise\n    if last_exc:\n        raise last_exc\n    raise RuntimeError(\"no chat model available\")\n\n\n# ---------------------------------------------------------------------------\n# Cinematic loaders (image shimmer + chat thinking)\n# ---------------------------------------------------------------------------\ndef image_loader_html(label: str | None = None) -\u003e str:\n    label = label or t(\"Membuat gambar Anda\", \"Creating your image\")\n    return f\"\"\"\n\u003cdiv class=\"img-loader\"\u003e\n  \u003cdiv class=\"img-loader-label\"\u003e\n    \u003cspan class=\"img-loader-dots\" aria-hidden=\"true\"\u003e\u003ci\u003e\u003c/i\u003e\u003ci\u003e\u003c/i\u003e\u003ci\u003e\u003c/i\u003e\u003c/span\u003e\n    \u003cspan\u003e{html.escape(label)}\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class=\"img-shimmer-box\" role=\"status\" aria-label=\"loading\"\u003e\n    \u003cdiv class=\"img-shimmer-glare\"\u003e\u003c/div\u003e\n    \u003cdiv class=\"img-shimmer-glare-2\"\u003e\u003c/div\u003e\n  \u003c/div\u003e\n\u003c/div\u003e\n\"\"\"\n\n\ndef thinking_html(steps_shown: list[str], active_index: int, progress_pct: float) -\u003e str:\n    \"\"\"Build thinking panel; active line gets fade-in + shimmer text + progress.\"\"\"\n    rows: list[str] = []\n    for i, text in enumerate(steps_shown):\n        if i \u003c active_index:\n            state = \"done show\"\n        elif i == active_index:\n            state = \"active show\"\n        else:\n            state = \"\"\n        rows.append(\n            f'\u003cdiv class=\"think-line {state}\"\u003e'\n            f'\u003cspan class=\"dot\"\u003e\u003c/span\u003e'\n            f'\u003cspan class=\"label\"\u003e{html.escape(text)}\u003c/span\u003e'\n            f\"\u003c/div\u003e\"\n        )\n    title = html.escape(t(\"Proses berpikir\", \"Thinking process\"))\n    pct = max(0.0, min(100.0, float(progress_pct)))\n    return f\"\"\"\n\u003cdiv class=\"think-panel\"\u003e\n  \u003cdiv class=\"think-inner\"\u003e\n    \u003cdiv class=\"think-header\"\u003e\n      \u003cdiv class=\"think-orb\" aria-hidden=\"true\"\u003e\u003c/div\u003e\n      \u003cdiv class=\"think-title-wrap\"\u003e\n        \u003cdiv class=\"think-title\"\u003e{title} · {pct:.0f}%\u003c/div\u003e\n        \u003cdiv class=\"think-progress\"\u003e\u003ci style=\"--p:{pct:.1f}%;width:{pct:.1f}%;\"\u003e\u003c/i\u003e\u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n    {\"\".join(rows)}\n  \u003c/div\u003e\n\u003c/div\u003e\n\"\"\"\n\n\ndef run_chat_thinking_animation(placeholder) -\u003e None:\n    \"\"\"\n    Show each thinking step with fade-in + progress bar.\n    Total ≈ 15 seconds (sum of CHAT_THINK_STEPS).\n    \"\"\"\n    shown: list[str] = []\n    elapsed = 0.0\n    total = float(THINK_TOTAL_SECONDS) or 15.0\n\n    for idx, (label, hold) in enumerate(CHAT_THINK_STEPS):\n        shown.append(label)\n        # progress at start of this step\n        pct = (elapsed / total) * 100.0\n        placeholder.markdown(\n            thinking_html(shown, active_index=idx, progress_pct=pct),\n            unsafe_allow_html=True,\n        )\n        step = max(float(hold), THINK_FADE_SECONDS)\n        # Mid-step progress bump for smoother bar\n        mid = step * 0.55\n        time.sleep(mid)\n        elapsed_mid = elapsed + mid\n        placeholder.markdown(\n            thinking_html(\n                shown,\n                active_index=idx,\n                progress_pct=(elapsed_mid / total) * 100.0,\n            ),\n            unsafe_allow_html=True,\n        )\n        time.sleep(step - mid)\n        elapsed += step\n\n    placeholder.markdown(\n        thinking_html(shown, active_index=len(shown), progress_pct=100.0),\n        unsafe_allow_html=True,\n    )\n    time.sleep(0.25)\n\n\ndef format_bubble_text(text: str) -\u003e str:\n    \"\"\"Escape HTML and keep simple line breaks for custom bubbles.\"\"\"\n    safe = html.escape(text or \"\")\n    return safe.replace(\"\\n\", \"\n\")\n\n\ndef chat_bubble_html(role: str, content: str) -\u003e str:\n    \"\"\"\n    WhatsApp layout with INLINE styles only (no CSS class dependency):\n    - AI   → LEFT  : [avatar][bubble]\n    - User → RIGHT : [bubble][avatar]  (avatar di paling kanan)\n\n    Uses a full-width div + text-align (works inside Streamlit markdown on mobile).\n    Avoids \u003ctable\u003e (often stripped by Streamlit HTML sanitizer).\n    \"\"\"\n    body = format_bubble_text(content)\n    is_user = role == \"user\"\n\n    av_base = (\n        \"display:inline-block;width:34px;height:34px;line-height:34px;\"\n        \"text-align:center;border-radius:50%;vertical-align:bottom;\"\n        \"border:1px solid rgba(255,255,255,0.18);font-size:16px;\"\n        \"box-sizing:border-box;\"\n    )\n\n    if is_user:\n        bubble_style = (\n            \"display:inline-block;max-width:72%;vertical-align:bottom;\"\n            \"padding:10px 14px;border-radius:18px 18px 4px 18px;\"\n            \"border:1px solid rgba(37,211,102,0.45);\"\n            \"background:linear-gradient(145deg,rgba(37,211,102,0.40),rgba(18,140,126,0.24));\"\n            \"color:#eef2ff;font-size:15px;line-height:1.45;text-align:left;\"\n            \"white-space:normal;word-break:break-word;overflow-wrap:anywhere;\"\n            \"box-shadow:0 8px 22px rgba(0,0,0,0.22);box-sizing:border-box;\"\n        )\n        avatar = (\n            f'\u003cspan style=\"{av_base}margin-left:8px;'\n            f'background:linear-gradient(135deg,rgba(37,211,102,0.7),rgba(18,140,126,0.5));\"\u003e'\n            f\"🙂\u003c/span\u003e\"\n        )\n        # bubble dulu, avatar di paling kanan\n        inner = f'\u003cspan style=\"{bubble_style}\"\u003e{body}\u003c/span\u003e{avatar}'\n        align = \"right\"\n    else:\n        bubble_style = (\n            \"display:inline-block;max-width:72%;vertical-align:bottom;\"\n            \"padding:10px 14px;border-radius:18px 18px 18px 4px;\"\n            \"border:1px solid rgba(255,255,255,0.22);\"\n            \"background:linear-gradient(125deg,rgba(139,124,255,0.52),rgba(244,114,182,0.34),\"\n            \"rgba(34,211,238,0.36),rgba(167,139,250,0.42));\"\n            \"color:#eef2ff;font-size:15px;line-height:1.45;text-align:left;\"\n            \"white-space:normal;word-break:break-word;overflow-wrap:anywhere;\"\n            \"box-shadow:0 10px 28px rgba(139,124,255,0.25);box-sizing:border-box;\"\n        )\n        avatar = (\n            f'\u003cspan style=\"{av_base}margin-right:8px;'\n            f'background:linear-gradient(135deg,rgba(139,124,255,0.8),rgba(34,211,238,0.5));\"\u003e'\n            f\"✨\u003c/span\u003e\"\n        )\n        # avatar kiri, bubble kanan avatar\n        inner = f'{avatar}\u003cspan style=\"{bubble_style}\"\u003e{body}\u003c/span\u003e'\n        align = \"left\"\n\n    return (\n        f'\u003cdiv style=\"display:block;width:100%;text-align:{align};'\n        f'margin:0 0 12px 0;box-sizing:border-box;\"\u003e'\n        f\"{inner}\"\n        f\"\u003c/div\u003e\"\n    )\n\n\ndef render_chat_history(messages: list[dict]) -\u003e None:\n    if not messages:\n        return\n    html_block = \"\".join(\n        chat_bubble_html(m.get(\"role\", \"assistant\"), m.get(\"content\", \"\"))\n        for m in messages\n    )\n    st.markdown(\n        f'\u003cdiv style=\"display:block;width:100%;box-sizing:border-box;\"\u003e{html_block}\u003c/div\u003e',\n        unsafe_allow_html=True,\n    )\n\n\ndef generate_image_with_min_delay(\n    account_id: str,\n    api_token: str,\n    prompt: str,\n    loader_slot,\n    min_seconds: float = IMAGE_MIN_LOADING_SECONDS,\n) -\u003e bytes:\n    \"\"\"Show shimmer loader, generate image, enforce minimum loading time.\"\"\"\n    loader_slot.markdown(image_loader_html(), unsafe_allow_html=True)\n    t0 = time.time()\n    try:\n        data = generate_image(account_id, api_token, prompt)\n    except Exception:\n        # Still respect a short beat so the UI doesn't flash\n        elapsed = time.time() - t0\n        if elapsed \u003c 1.2:\n            time.sleep(1.2 - elapsed)\n        loader_slot.empty()\n        raise\n\n    elapsed = time.time() - t0\n    remaining = float(min_seconds) - elapsed\n    if remaining \u003e 0:\n        time.sleep(remaining)\n\n    loader_slot.empty()\n    return data\n\n\n# ---------------------------------------------------------------------------\n# Credentials\n# ---------------------------------------------------------------------------\ncf_account, cf_token = load_cf_credentials()\ngroq_key = load_groq_key()\ngroq_model = load_groq_model()\n\nimage_ready = bool(cf_account and cf_token)\nchat_ready = bool(groq_key)\n\n\n# ---------------------------------------------------------------------------\n# UI\n# ---------------------------------------------------------------------------\nst.markdown(\n    f\"\"\"\n\u003cdiv class=\"glass-hero\"\u003e\n  \u003cdiv class=\"eyebrow\"\u003e✨ AI Studio\u003c/div\u003e\n  \u003cdiv class=\"title\"\u003eCreate · Chat · Imagine\u003c/div\u003e\n  \u003cp class=\"subtitle\"\u003e{t(\n        \"Gambar + chat AI dalam satu tempat — tampilan glass modern\",\n        \"Image generation + AI chat in one place — glass modern UI\",\n    )}\u003c/p\u003e\n\u003c/div\u003e\n\"\"\",\n    unsafe_allow_html=True,\n)\n\ntab_image, tab_chat = st.tabs(\n    [\n        \"🖼️ \" + t(\"Gambar\", \"Image\"),\n        \"💬 \" + t(\"Chat\", \"Chat\"),\n    ]\n)\n\n# ========================= IMAGE TAB =========================\nwith tab_image:\n    if not image_ready:\n        st.error(\n            t(\n                \"Fitur gambar belum dikonfigurasi oleh pemilik.\",\n                \"Image feature is not configured by the owner yet.\",\n            )\n        )\n    else:\n        img_prompt = st.text_area(\n            t(\"Deskripsikan gambar yang ingin dibuat\", \"Describe the image you want\"),\n            placeholder=(\n                \"Contoh / Example:\\n\"\n                \"• Cute anime girl in a pink hoodie, chibi style\\n\"\n                \"• Kopi latte art berbentuk hati di meja kayu, cahaya pagi\\n\"\n                \"• Cyberpunk city street at night, neon rain\"\n            ),\n            height=130,\n            key=\"image_prompt_input\",\n        )\n\n        c1, c2 = st.columns([3, 1])\n        with c1:\n            gen = st.button(\n                \"✨ \" + t(\"Generate Gambar\", \"Generate Image\"),\n                type=\"primary\",\n                use_container_width=True,\n                key=\"btn_gen_image\",\n            )\n        with c2:\n            if st.button(t(\"Reset\", \"Clear\"), use_container_width=True, key=\"btn_clear_image\"):\n                st.session_state.img_bytes = None\n                st.session_state.img_prompt = \"\"\n                st.session_state.img_error = None\n                st.rerun()\n\n        # Persistent slots so loader/result don't jump awkwardly\n        img_loader_slot = st.empty()\n        img_status_slot = st.empty()\n\n        if gen:\n            st.session_state.img_error = None\n            if not img_prompt or not img_prompt.strip():\n                st.session_state.img_error = t(\n                    \"⚠️ Prompt masih kosong.\",\n                    \"⚠️ Please enter a prompt first.\",\n                )\n            else:\n                try:\n                    t0 = time.time()\n                    data = generate_image_with_min_delay(\n                        cf_account,\n                        cf_token,\n                        img_prompt.strip(),\n                        loader_slot=img_loader_slot,\n                        min_seconds=IMAGE_MIN_LOADING_SECONDS,\n                    )\n                    st.session_state.img_bytes = data\n                    st.session_state.img_prompt = img_prompt.strip()\n                    st.session_state.img_error = None\n                    img_status_slot.success(\n                        t(\n                            f\"Berhasil ({time.time() - t0:.1f}s)\",\n                            f\"Done ({time.time() - t0:.1f}s)\",\n                        )\n                    )\n                except Exception as e:\n                    st.session_state.img_bytes = None\n                    msg = str(e)\n                    if msg.startswith(\"⚠️\") or msg.startswith(\"⏳\") or msg.startswith(\"⌛\") or msg.startswith(\"❌\"):\n                        st.session_state.img_error = msg\n                    else:\n                        st.session_state.img_error = public_error_image(None, msg, e)\n\n        if st.session_state.img_error:\n            st.error(st.session_state.img_error)\n\n        if st.session_state.img_bytes:\n            st.markdown(\"---\")\n            safe_prompt = html.escape(st.session_state.img_prompt or \"\")\n            st.markdown(\n                f\"\"\"\n\u003cdiv class=\"glass-panel\"\u003e\n  \u003cstrong style=\"color:#eef2ff;\"\u003e{html.escape(t(\"Hasil\", \"Result\"))}\u003c/strong\u003e\n  \u003cdiv style=\"color:rgba(238,242,255,0.65);font-size:0.85rem;margin-top:0.2rem;\"\u003e\n    {safe_prompt}\n  \u003c/div\u003e\n\u003c/div\u003e\n\"\"\",\n                unsafe_allow_html=True,\n            )\n            st.image(\n                st.session_state.img_bytes,\n                use_container_width=True,\n            )\n            ts = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n            st.download_button(\n                label=\"⬇️ \" + t(\"Unduh PNG\", \"Download PNG\"),\n                data=st.session_state.img_bytes,\n                file_name=f\"image_{ts}.png\",\n                mime=\"image/png\",\n                use_container_width=True,\n                key=\"btn_dl_image\",\n            )\n\n# ========================= CHAT TAB =========================\nwith tab_chat:\n    if not chat_ready:\n        st.error(\n            t(\n                \"Fitur chat belum dikonfigurasi oleh pemilik.\",\n                \"Chat feature is not configured by the owner yet.\",\n            )\n        )\n    else:\n        head_l, head_r = st.columns([3, 1])\n        with head_l:\n            st.caption(\n                t(\n                    \"Chat AI · konteks panjang via Groq\",\n                    \"AI chat · long context via Groq\",\n                )\n            )\n        with head_r:\n            if st.button(t(\"Hapus chat\", \"Clear chat\"), use_container_width=True, key=\"btn_clear_chat\"):\n                st.session_state.chat_messages = []\n                st.session_state.chat_error = None\n                st.rerun()\n\n        def _history_html(msgs: list[dict]) -\u003e str:\n            if not msgs:\n                return \"\"\n            body = \"\".join(\n                chat_bubble_html(m.get(\"role\", \"assistant\"), m.get(\"content\", \"\"))\n                for m in msgs\n            )\n            return (\n                f'\u003cdiv style=\"display:block;width:100%;box-sizing:border-box;\"\u003e{body}\u003c/div\u003e'\n            )\n\n        history_slot = st.empty()\n        history_slot.markdown(\n            _history_html(st.session_state.chat_messages),\n            unsafe_allow_html=True,\n        )\n\n        if st.session_state.chat_error:\n            st.error(st.session_state.chat_error)\n\n        user_text = st.chat_input(\n            \"ask anythink\",\n            key=\"chat_input_main\",\n        )\n\n        if user_text and user_text.strip():\n            st.session_state.chat_error = None\n            st.session_state.chat_messages.append(\n                {\"role\": \"user\", \"content\": user_text.strip()}\n            )\n            # Refresh history: user RIGHT, avatar di paling kanan bubble\n            history_slot.markdown(\n                _history_html(st.session_state.chat_messages),\n                unsafe_allow_html=True,\n            )\n\n            think_slot = st.empty()\n            answer_slot = st.empty()\n\n            try:\n                run_chat_thinking_animation(think_slot)\n                client = build_chat_client(groq_key)\n                think_slot.empty()\n\n                full = \"\"\n                for piece in stream_chat_with_fallback(\n                    client,\n                    groq_model,\n                    st.session_state.chat_messages,\n                ):\n                    full += piece or \"\"\n                    answer_slot.markdown(\n                        chat_bubble_html(\"assistant\", full),\n                        unsafe_allow_html=True,\n                    )\n\n                if not full:\n                    full = \"…\"\n                    answer_slot.markdown(\n                        chat_bubble_html(\"assistant\", full),\n                        unsafe_allow_html=True,\n                    )\n\n                st.session_state.chat_messages.append(\n                    {\"role\": \"assistant\", \"content\": str(full)}\n                )\n                st.rerun()\n            except Exception as e:\n                think_slot.empty()\n                err = public_error_chat(e)\n                st.session_state.chat_error = err\n                st.error(err)\n```"])</script><script>self.__next_f.push([1,"19:{\"messages\":[{\"id\":\"01a041fa-6471-7662-957a-49ae57c156e9\",\"metadata\":{\"manifestNodeId\":null,\"nodeId\":\"01a041fa-6471-7662-957a-49ae57c156e9\",\"pending\":false,\"requiresReview\":false,\"feedback\":{}},\"role\":\"user\",\"parts\":[{\"type\":\"text\",\"text\":\"saya mau gabungkan 3 aplikasi ai saya dan sebelum saya perintah gabungkan kode yang saya kirim, jangan buat kode terlebih dahulu\"}]},{\"id\":\"01a041fa-8a3a-71db-93ee-415daec0c42b\",\"metadata\":{\"manifestNodeId\":null,\"nodeId\":\"01a041fa-8a3a-71db-93ee-415daec0c42b\",\"pending\":false,\"requiresReview\":false,\"feedback\":{\"checkIn\":\"approve\"}},\"role\":\"assistant\",\"parts\":[{\"type\":\"step-start\"},{\"type\":\"reasoning\",\"text\":\"\",\"state\":\"done\"},{\"type\":\"text\",\"text\":\"Baik, saya mengerti! 👍\\n\\nSaya **tidak akan membuat kode apapun** sampai Anda memberikan perintah untuk menggabungkannya.\\n\\nSilakan kirimkan kode dari 3 aplikasi AI Anda satu per satu (atau sekaligus). Sambil menunggu, beberapa informasi yang nanti akan membantu proses penggabungan:\\n\\n1. **Apa fungsi masing-masing aplikasi?** (misal: chatbot, generator gambar, dll.)\\n2. **Bahasa/framework apa yang digunakan?** (Python, JavaScript, dll.)\\n3. **Bagaimana bentuk gabungannya nanti?** — misalnya satu aplikasi dengan menu/tab untuk memilih fitur, atau semua fitur berjalan bersamaan dalam satu halaman.\\n\\nSilakan kirim kodenya kapan saja. Saya akan menunggu perintah Anda sebelum mulai menggabungkan. 📥\",\"state\":\"done\",\"providerMetadata\":{\"anthropic\":{\"signature\":\"\"}}}]},{\"id\":\"01a041fd-2a60-7a7e-b986-e033558525e5\",\"metadata\":{\"manifestNodeId\":null,\"nodeId\":\"01a041fd-2a60-7a7e-b986-e033558525e5\",\"pending\":false,\"requiresReview\":false,\"feedback\":{}},\"role\":\"user\",\"parts\":[{\"type\":\"text\",\"text\":\"opsi pertama itu : multi ai, generate gambar, dan ai chat biasa\\n\\nopsi kedua : file [app.py](http://app.py)\\n\\nopsi ketiga : buat semua fitur pada setiap app menjadi 1 kecuali jikalau ada perintah yang harus memasukkan foto, nanti itu terakhir aja dihilangkan dulu kalau di file nya ada itu\"}]},{\"id\":\"01a041fd-61b0-7deb-8fec-c72a351199a0\",\"metadata\":{\"manifestNodeId\":null,\"nodeId\":\"01a041fd-61b0-7deb-8fec-c72a351199a0\",\"pending\":false,\"requiresReview\":false,\"feedback\":{\"checkIn\":\"approve\"}},\"role\":\"assistant\",\"parts\":[{\"type\":\"step-start\"},{\"type\":\"reasoning\",\"text\":\"\",\"state\":\"done\"},{\"type\":\"text\",\"text\":\"Siap, sudah saya catat semuanya! 📝\\n\\n**Ringkasan rencana penggabungan:**\\n\\n| Poin | Detail |\\n|------|--------|\\n| **Aplikasi yang digabung** | 1. Multi AI, 2. Generate Gambar, 3. AI Chat biasa |\\n| **Framework** | Python — file `app.py` |\\n| **Bentuk gabungan** | Semua fitur jadi **1 aplikasi** |\\n| **Pengecualian** | Fitur yang butuh **input/upload foto** dihilangkan dulu (sementara) |\\n\\nSekarang tinggal satu langkah lagi: **silakan kirim/tempel kode dari ketiga file `app.py` tersebut** (bisa satu per satu atau langsung ketiganya, beri label saja misalnya \\\"ini app multi AI\\\", \\\"ini app generate gambar\\\", \\\"ini app chat\\\").\\n\\nSetelah ketiga kodenya saya terima **dan Anda beri perintah \\\"gabungkan\\\"**, baru saya akan mulai membuat kode gabungannya. Saya tunggu ya! 📥\",\"state\":\"done\",\"providerMetadata\":{\"anthropic\":{\"signature\":\"\"}}}]},{\"id\":\"01a041fe-4084-7f5a-ab34-3bc9de803a7c\",\"metadata\":{\"manifestNodeId\":null,\"nodeId\":\"01a041fe-4084-7f5a-ab34-3bc9de803a7c\",\"pending\":false,\"requiresReview\":false,\"feedback\":{}},\"role\":\"user\",\"parts\":[{\"type\":\"text\",\"text\":\"$2b\"}]},{\"id\":\"01a041fe-511e-7088-8172-f20fe3ba6633\",\"metadata\":{\"manifestNodeId\":null,\"nodeId\":\"01a041fe-511e-7088-8172-f20fe3ba6633\",\"pending\":false,\"requiresReview\":false,\"feedback\":{\"checkIn\":\"approve\"}},\"role\":\"assistant\",\"parts\":[{\"type\":\"step-start\"},{\"type\":\"reasoning\",\"text\":\"\",\"state\":\"done\"},{\"type\":\"text\",\"text\":\"✅ **Kode pertama diterima!** (Belum saya buat kode apapun, sesuai instruksi.)\\n\\n**Catatan saya untuk App 1 — \\\"AI Studio\\\":**\\n\\n| Aspek | Detail |\\n|-------|--------|\\n| Framework | Streamlit (Python) |\\n| **Tab 1: Generate Gambar** | Cloudflare Workers AI — model `FLUX-1-schnell` |\\n| **Tab 2: AI Chat** | Groq API — model `gpt-oss-120b` + fallback, streaming, konteks panjang |\\n| UI | Tema glass modern (`styles.py` → `inject_glass_theme()`), bilingual ID/EN, bubble chat gaya WhatsApp, animasi \\\"thinking\\\" ~15 detik |\\n| Kredensial | Via Streamlit Secrets (Cloudflare + Groq) |\\n| Input foto? | ❌ Tidak ada — aman, tidak perlu dihilangkan |\\n\\n📌 **Perlu dicatat:** file ini meng-import `from styles import inject_glass_theme` — jadi nanti kalau ada, kirim juga file `styles.py`-nya (atau nanti saya sesuaikan saat penggabungan).\\n\\nSekarang silakan kirim **kode App 2** (Multi AI?) dan **App 3** (AI chat biasa?). Saya tunggu — belum akan menggabungkan sampai Anda beri perintah. 📥\",\"state\":\"done\",\"providerMetadata\":{\"anthropic\":{\"signature\":\"\"}}}]},{\"id\":\"01a041ff-3600-7eb9-b8be-c8a5e5d36ebe\",\"metadata\":{\"manifestNodeId\":null,\"nodeId\":\"01a041ff-3600-7eb9-b8be-c8a5e5d36ebe\",\"pending\":false,\"requiresReview\":false,\"feedback\":{}},\"role\":\"user\",\"parts\":[{\"type\":\"text\",\"text\":\"nah untuk file style css nya kita nggak usah pakai file bawaan nanti kita edit sendiri\"}]},{\"id\":\"01a041ff-529e-70e4-beb5-ed4f10415412\",\"metadata\":{\"manifestNodeId\":null,\"nodeId\":\"01a041ff-529e-70e4-beb5-ed4f10415412\",\"pending\":false,\"requiresReview\":false,\"feedback\":{\"checkIn\":\"approve\"}},\"role\":\"assistant\",\"parts\":[{\"type\":\"step-start\"},{\"type\":\"reasoning\",\"text\":\"\",\"state\":\"done\"},{\"type\":\"text\",\"text\":\"Oke, noted! 🎨\\n\\n**Update catatan:**\\n\\n| Poin | Keputusan |\\n|------|-----------|\\n| `styles.py` bawaan | ❌ **Tidak dipakai** |\\n| Styling/tema | ✏️ Nanti kita **buat \u0026 edit sendiri** saat penggabungan |\\n\\nJadi nanti saat menggabungkan, import `from styles import inject_glass_theme` akan saya sesuaikan dengan style baru yang kita buat sendiri.\\n\\nSilakan lanjut kirim **kode App 2** dan **App 3**. Saya masih menunggu dan belum membuat kode apapun. 📥\",\"state\":\"done\",\"providerMetadata\":{\"anthropic\":{\"signature\":\"\"}}}]}],\"session\":{\"publicAccessToken\":\"eyJhbGciOiJIUzI1NiJ9..9Xhq6AjZkgfRfZQak7Zdb-jmrDWPBabOxHMW9MXKL7w\",\"lastEventId\":\"470\"},\"productMode\":\"chat\",\"feedbackType\":\"check_in\",\"customFeedbackArm\":null}\n"])</script><script type="module" src="./logo_thinking_small_files/v3d52b47920f24c319d37e2661827c42b1787588026925" integrity="sha512-d9sL6GJLXn6fInD1+TVXhTcQOsmxeHfmHAvwGDIxp5TO+uo1fiWW7mHomMj4MLRlCsJDTqXzWLHJFFlPCEIj/A==" data-cf-beacon="{&quot;version&quot;:&quot;2024.11.0&quot;,&quot;token&quot;:&quot;1954b47c125f43f8b4338b3c4f804e4f&quot;}" crossorigin="anonymous"></script>

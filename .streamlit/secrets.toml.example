# ============================================================================
# Ampera Trinity AI — Contoh Streamlit Secrets
# ----------------------------------------------------------------------------
# Cara pakai:
#   1. Salin berkas ini menjadi  .streamlit/secrets.toml
#        cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   2. Isi nilainya dengan key milikmu sendiri
#   3. Restart Streamlit
#
# JANGAN commit .streamlit/secrets.toml ke Git (sudah ada di .gitignore).
# Untuk Streamlit Cloud, tempel isi berkas ini di Settings -> Secrets.
# ============================================================================

# ── WAJIB: Chat, analisis gambar, transkripsi suara ─────────────────────────
# Ambil gratis di https://console.groq.com  (menu API Keys)
GROQ_API_KEY = "gsk_ganti_dengan_key_anda"

# ── OPSIONAL: Generate gambar (Cloudflare Workers AI - FLUX) ────────────────
# Account ID  : terlihat di URL dashboard https://dash.cloudflare.com/<ID>/...
# API Token   : My Profile -> API Tokens -> Create Token
#               Permission: Account -> Workers AI -> Read
# Tanpa dua nilai ini, mode generate gambar otomatis disembunyikan.
CF_ACCOUNT_ID = ""
CF_API_TOKEN  = ""
